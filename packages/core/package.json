{
  "name": "tiledb-node",
  "version": "1.0.0",
  "description": "High-performance native Node.js binding for the TileDB C++ library",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --pool=forks"
  },
  "optionalDependencies": {
    "@tiledb-node/darwin-arm64": "workspace:*",
    "@tiledb-node/darwin-x64": "workspace:*",
    "@tiledb-node/linux-arm64": "workspace:*",
    "@tiledb-node/linux-x64": "workspace:*",
    "@tiledb-node/win32-x64": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "vitest": "~3.1.0",
    "@types/node": "~20.19.0"
  }
}
