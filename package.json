{
  "name": "tiledb-node-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm --filter '*' run build",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/build packages/*/dist packages/*/tiledb-dist",
    "test": "pnpm --filter '*' run test",
    "typecheck": "pnpm --filter tiledb-node run typecheck",
    "lint": "pnpm --filter tiledb-node run lint",
    "audit": "pnpm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "semantic-release": "^25.0.3",
    "typescript": "~5.9.0"
  }
}
